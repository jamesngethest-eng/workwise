HOST=127.0.0.1
PORT=8000
WORKWISE_DATA_DIR=.workwise-data
NODE_ENV=development
# Set a long random value before public deployment. The first admin setup requires it.
WORKWISE_ADMIN_SETUP_KEY=replace-with-a-long-random-secret

# ---- Plans (free until BILLING_START_DATE, then Free limits apply unless a paid plan is active) ----
BILLING_START_DATE=2026-12-05
BILLING_CURRENCY=USD
FREELANCER_PLAN_PRICE=5
HIRER_PLAN_PRICE=15
FREE_PROPOSALS_PER_MONTH=5
FREE_ACTIVE_JOBS=1
PAYMENT_INSTRUCTIONS=Send the amount to M-Pesa Till 123456, then enter the transaction code.

# ---- Account-recovery emails: choose ONE ----
# A) Brevo over HTTPS (works on Render's free tier). MAIL_FROM must be a sender verified in Brevo (a Gmail address is fine).
BREVO_API_KEY=
MAIL_FROM=you@gmail.com
MAIL_FROM_NAME=Workwise
# B) Gmail SMTP (needs a host that allows SMTP ports, i.e. NOT Render free). Use a Google "App password".
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ---- Chat uploads ----
MAX_UPLOAD_MB=50
MAX_DAILY_UPLOAD_MB=500

# ---- Firewall ----
# Minutes a scanner/bot IP stays blocked (honeypot hits block for 24h).
PROBE_BLOCK_MINUTES=60

